{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve Falcon Lab",
      "type": "shell",
      "command": "python server.py",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^Falcon Lab: (.*)$",
          "match": 1
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "npm test",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "npm run lint",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
